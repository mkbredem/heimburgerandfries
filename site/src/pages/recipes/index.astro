---
import Base from '../../layouts/Base.astro';
import SearchForm from '../../components/SearchForm.astro';
import { SECTIONS } from '../../data/sections';
import { bookRecipes, recipeUrl, sectionUrl } from '../../lib/recipes';

const recipes = await bookRecipes();
---
<Base title="All recipes" current="recipes">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> › All recipes</nav>
    <h1 style="font-size: clamp(32px, 4.5vw, 48px); color: var(--rose); margin-bottom: 20px">All {recipes.length} recipes</h1>
    <SearchForm />
    {SECTIONS.map((s) => (
      <section style="margin-top: 40px">
        <div class="section-title"><h2><a href={sectionUrl(s.slug)} style="text-decoration: none; color: var(--rose)">{s.name}</a></h2></div>
        <ul class="az">
          {recipes.filter((r) => r.data.section === s.slug).map((r) => <li><a href={recipeUrl(r.id)}>{r.data.title}</a></li>)}
        </ul>
      </section>
    ))}
  </div>
</Base>
<style>
  .az { columns: 3 220px; column-gap: 32px; margin: 0; padding: 0; list-style: none; }
  .az li { break-inside: avoid; padding: 4px 0; }
  .az a { text-decoration: none; }
  .az a:hover { text-decoration: underline; }
</style>
