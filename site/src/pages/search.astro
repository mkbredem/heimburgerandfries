---
import Base from '../layouts/Base.astro';
---
<Base title="Search" current="recipes">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> › Search</nav>
    <h1 style="font-size: clamp(32px, 4.5vw, 48px); color: var(--rose); margin-bottom: 20px">Search the cookbook</h1>
    <div id="search"></div>
    <noscript><p>Search needs JavaScript. You can <a href="/recipes/">browse all recipes</a> instead.</p></noscript>
    <p style="margin-top: 32px; font-size: 15px; color: var(--muted)">Search covers recipe names and every recipe that has been typed up. Recipes not typed yet are found by name only.</p>
  </div>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline src="/js/search.js" defer></script>
</Base>
<style is:global>
  #search { --pagefind-ui-primary: #2F5E82; --pagefind-ui-text: #2E2A26; --pagefind-ui-background: #FFFDF8; --pagefind-ui-border: #2F5E82; --pagefind-ui-tag: #F4E3E6; --pagefind-ui-border-width: 2px; --pagefind-ui-border-radius: 12px; --pagefind-ui-font: 'Source Sans 3', system-ui, sans-serif; }
</style>
