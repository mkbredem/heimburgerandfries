---
import { shareLink } from '../data/site';
interface Props { recipe?: string; type?: string; label?: string; variant?: 'rose' | 'outline-rose' | 'outline' }
const { recipe, type, label = 'Share your version', variant = 'rose' } = Astro.props;
const href = shareLink(recipe, type) ?? '/share/';
const external = href.startsWith('http');
---
<a class={`btn btn-${variant}`} href={href} rel={external ? 'noopener' : undefined} target={external ? '_blank' : undefined}>{label}</a>
